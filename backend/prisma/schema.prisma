// ─────────────────────────────────────────────────────────────────────────────
// KNIGHTSBRIDGE COMPLIANCE CENTRE — Prisma Schema
// Database: Vercel Postgres (PostgreSQL)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  walletAddress   String?   @unique
  name            String?
  company         String?
  plan            PlanTier  @default(FREE)
  isAdmin         Boolean   @default(false)
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  apiKeys         ApiKey[]
  payments        Payment[]
  scamReports     ScamReport[]

  @@index([email])
  @@index([walletAddress])
  @@map("users")
}

// ── API Keys ──────────────────────────────────────────────────────────────────
model ApiKey {
  id              String    @id @default(cuid())
  key             String    @unique
  name            String?
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            PlanTier  @default(FREE)
  isActive        Boolean   @default(true)
  rpmLimit        Int       @default(60)
  monthlyLimit    Int       @default(1000)
  totalRequests   Int       @default(0)
  monthRequests   Int       @default(0)
  lastUsed        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  usageLogs       ApiUsage[]

  @@index([key])
  @@index([userId])
  @@map("api_keys")
}

// ── API Usage Logs ────────────────────────────────────────────────────────────
model ApiUsage {
  id              String    @id @default(cuid())
  apiKeyId        String
  apiKey          ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint        String
  method          String    @default("GET")
  statusCode      Int
  responseTimeMs  Int?
  ipAddress       String?
  userAgent       String?
  requestBody     Json?
  createdAt       DateTime  @default(now())

  @@index([apiKeyId])
  @@index([createdAt])
  @@map("api_usage")
}

// ── Scam Registry ─────────────────────────────────────────────────────────────
model ScamRegistry {
  id                  String              @id @default(cuid())
  walletAddress       String?
  contractAddress     String?
  scamType            ScamType
  riskScore           Int                 @default(0)
  riskLevel           RiskLevel           @default(LOW)
  evidenceIpfsHash    String?
  reporterWallet      String?
  verificationStatus  VerificationStatus  @default(PENDING)
  description         String?
  chainId             Int                 @default(1)
  isActive            Boolean             @default(true)
  verifiedAt          DateTime?
  verifiedBy          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([walletAddress])
  @@index([contractAddress])
  @@index([scamType])
  @@index([riskLevel])
  @@map("scam_registry")
}

// ── Scam Reports (user-submitted) ─────────────────────────────────────────────
model ScamReport {
  id                  String              @id @default(cuid())
  reporterId          String?
  reporter            User?               @relation(fields: [reporterId], references: [id])
  reporterWallet      String?
  targetWallet        String?
  targetContract      String?
  scamType            ScamType
  description         String
  evidenceUrls        String[]
  evidenceIpfsHash    String?
  stakeAmount         Float?
  stakeTxHash         String?
  status              ReportStatus        @default(PENDING)
  adminNotes          String?
  chainId             Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([reporterWallet])
  @@index([targetWallet])
  @@index([status])
  @@map("scam_reports")
}

// ── Wallet Risk Scores ────────────────────────────────────────────────────────
model WalletRiskScore {
  id              String    @id @default(cuid())
  walletAddress   String
  chainId         Int       @default(1)
  riskScore       Int
  riskLevel       RiskLevel
  flags           String[]
  details         Json?
  txCount         Int?
  firstSeen       DateTime?
  lastSeen        DateTime?
  totalVolume     Float?
  scamInteractions Int?    @default(0)
  rugInteractions Int?     @default(0)
  mixerInteractions Int?   @default(0)
  calculatedAt    DateTime  @default(now())
  expiresAt       DateTime

  @@unique([walletAddress, chainId])
  @@index([walletAddress])
  @@index([riskLevel])
  @@map("wallet_risk_scores")
}

// ── Token Rug Scores ──────────────────────────────────────────────────────────
model TokenRugScore {
  id                  String    @id @default(cuid())
  tokenAddress        String
  chainId             Int       @default(1)
  tokenName           String?
  tokenSymbol         String?
  deployerAddress     String?
  rugRiskScore        Int
  rugRiskLevel        RiskLevel
  warnings            String[]
  details             Json?
  totalSupply         String?
  liquidityUSD        Float?
  liquidityLocked     Boolean   @default(false)
  lockDuration        Int?
  devWalletPercent    Float?
  hasOwnerMint        Boolean   @default(false)
  hasBlacklist        Boolean   @default(false)
  hasTransferTax      Boolean   @default(false)
  isVerified          Boolean   @default(false)
  deployedAt          DateTime?
  calculatedAt        DateTime  @default(now())
  expiresAt           DateTime

  @@unique([tokenAddress, chainId])
  @@index([tokenAddress])
  @@index([rugRiskLevel])
  @@index([deployedAt])
  @@map("token_rug_scores")
}

// ── Indexed Blocks ────────────────────────────────────────────────────────────
model IndexedBlock {
  id          String    @id @default(cuid())
  blockNumber BigInt    @unique
  blockHash   String    @unique
  chainId     Int       @default(1)
  timestamp   DateTime
  txCount     Int       @default(0)
  indexedAt   DateTime  @default(now())

  @@index([blockNumber])
  @@index([chainId])
  @@map("indexed_blocks")
}

// ── Indexed Transactions ──────────────────────────────────────────────────────
model IndexedTransaction {
  id            String    @id @default(cuid())
  txHash        String    @unique
  blockNumber   BigInt
  chainId       Int       @default(1)
  fromAddress   String
  toAddress     String?
  value         String    @default("0")
  gasUsed       String?
  isContractCall Boolean  @default(false)
  methodId      String?
  timestamp     DateTime
  indexedAt     DateTime  @default(now())

  @@index([txHash])
  @@index([fromAddress])
  @@index([toAddress])
  @@map("indexed_transactions")
}

// ── Indexed Events ────────────────────────────────────────────────────────────
model IndexedEvent {
  id              String    @id @default(cuid())
  txHash          String
  logIndex        Int
  blockNumber     BigInt
  chainId         Int       @default(1)
  contractAddress String
  eventName       String
  eventData       Json
  timestamp       DateTime
  indexedAt       DateTime  @default(now())

  @@unique([txHash, logIndex])
  @@index([contractAddress])
  @@index([eventName])
  @@index([blockNumber])
  @@map("indexed_events")
}

// ── DEX Liquidity Pools ───────────────────────────────────────────────────────
model LiquidityPool {
  id              String    @id @default(cuid())
  poolAddress     String    @unique
  chainId         Int       @default(1)
  dex             String
  token0          String
  token1          String
  reserve0        String?
  reserve1        String?
  liquidityUSD    Float?
  isLocked        Boolean   @default(false)
  lockTxHash      String?
  createdAtBlock  BigInt?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([token0])
  @@index([token1])
  @@map("liquidity_pools")
}

// ── Payments ──────────────────────────────────────────────────────────────────
model Payment {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  plan            PlanTier
  amount          Float
  currency        String          @default("USDT")
  network         PaymentNetwork
  txHash          String?         @unique
  fromWallet      String?
  toWallet        String
  status          PaymentStatus   @default(PENDING)
  confirmedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([txHash])
  @@index([status])
  @@map("payments")
}

// ── Known Mixers / Scam Contracts ─────────────────────────────────────────────
model KnownBadAddress {
  id          String    @id @default(cuid())
  address     String
  chainId     Int       @default(1)
  category    String    // "mixer", "exploit", "phishing", etc.
  label       String?
  source      String?   // "manual", "chainalysis", "community"
  createdAt   DateTime  @default(now())

  @@unique([address, chainId])
  @@index([address])
  @@map("known_bad_addresses")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScamType {
  RUG_PULL
  PHISHING
  HONEYPOT
  FAKE_TOKEN
  PUMP_AND_DUMP
  MIXER
  MALICIOUS_CONTRACT
  EXPLOIT
  SOCIAL_ENGINEERING
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  UNDER_REVIEW
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ESCALATED
}

enum PaymentStatus {
  PENDING
  CONFIRMING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentNetwork {
  ETHEREUM
  POLYGON
  TRON
  BSC
}
