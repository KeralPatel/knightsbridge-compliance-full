# ─────────────────────────────────────────────────────────────
# KNIGHTSBRIDGE COMPLIANCE CENTRE — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
POSTGRES_URL="postgresql://user:password@host:5432/kcc_db?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/kcc_db?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/kcc_db?sslmode=require"

# ── RPC Providers ─────────────────────────────────────────────
ALCHEMY_API_KEY="your_alchemy_api_key"
ALCHEMY_ETH_RPC="https://eth-mainnet.g.alchemy.com/v2/your_key"
ALCHEMY_POLYGON_RPC="https://polygon-mainnet.g.alchemy.com/v2/your_key"
ALCHEMY_BASE_RPC="https://base-mainnet.g.alchemy.com/v2/your_key"

INFURA_API_KEY="your_infura_api_key"
INFURA_ETH_RPC="https://mainnet.infura.io/v3/your_key"

QUICKNODE_ETH_RPC="https://your-quicknode-endpoint.quiknode.pro/your_key"

# Primary RPC to use (alchemy | infura | quicknode)
PRIMARY_RPC_PROVIDER="alchemy"
ETH_RPC_URL="${ALCHEMY_ETH_RPC}"
POLYGON_RPC_URL="${ALCHEMY_POLYGON_RPC}"
BASE_RPC_URL="${ALCHEMY_BASE_RPC}"

# ── IPFS / Pinata ─────────────────────────────────────────────
PINATA_API_KEY="your_pinata_api_key"
PINATA_SECRET_KEY="your_pinata_secret_key"
PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# ── Crypto Payment Wallets ────────────────────────────────────
USDT_WALLET_ETH="0xYourEthereumUSDTWallet"
USDT_WALLET_POLYGON="0xYourPolygonUSDTWallet"
USDT_WALLET_TRON="TYourTronUSDTWallet"

# USDT Contract Addresses
USDT_CONTRACT_ETH="0xdAC17F958D2ee523a2206206994597C13D831ec7"
USDT_CONTRACT_POLYGON="0xc2132D05D31c914a87C6611C10748AEb04B58e8F"

# ── JWT & Auth ────────────────────────────────────────────────
JWT_SECRET="your_super_secret_jwt_key_min_32_chars"
ADMIN_API_KEY="your_admin_api_key_here"

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_HOST="0.0.0.0"
NODE_ENV="development"

# ── Frontend (Next.js public vars) ───────────────────────────
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id"
NEXT_PUBLIC_ALCHEMY_KEY="your_alchemy_key"
NEXT_PUBLIC_CHAIN_ID="1"

# ── Smart Contracts ───────────────────────────────────────────
COMPLIANCE_REGISTRY_ADDRESS="0x0000000000000000000000000000000000000000"
SCAM_REGISTRY_ADDRESS="0x0000000000000000000000000000000000000000"
REPUTATION_SCORE_ADDRESS="0x0000000000000000000000000000000000000000"
REPORT_STAKING_ADDRESS="0x0000000000000000000000000000000000000000"
KYC_SBT_ADDRESS="0x0000000000000000000000000000000000000000"

# ── Hardhat / Contract Deployment ────────────────────────────
DEPLOYER_PRIVATE_KEY="0xYourDeployerPrivateKey"
ETHERSCAN_API_KEY="your_etherscan_api_key"

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_STARTER_RPM=60
RATE_LIMIT_PRO_RPM=600
RATE_LIMIT_ENTERPRISE_RPM=6000

# ── Indexer ──────────────────────────────────────────────────
INDEXER_START_BLOCK="latest"
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_BATCH_SIZE=100
UNISWAP_V2_FACTORY="0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f"
UNISWAP_V3_FACTORY="0x1F98431c8aD98523631AE4a59f267346ea31F984"
SUSHISWAP_FACTORY="0xC0AEe478e3658e2610c5F7A4A2E1777cE9e4f2Ac"
