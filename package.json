{
  "name": "knightsbridge-compliance-centre",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "contracts",
    "indexer",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:indexer\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:indexer": "npm --workspace=indexer run dev",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
